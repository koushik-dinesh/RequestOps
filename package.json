{
  "name": "requestops-v2",
  "version": "1.0.0",
  "description": "RequestOps internal software request and change management system.",
  "main": "backend/main.py",
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "backend/.venv/bin/python -m uvicorn main:app --app-dir backend --host 0.0.0.0 --port 4000 --reload",
    "dev:web": "vite --config frontend/vite.config.js",
    "start": "backend/.venv/bin/python -m uvicorn main:app --app-dir backend --host 0.0.0.0 --port 4000",
    "build": "vite build --config frontend/vite.config.js",
    "preview": "vite preview --config frontend/vite.config.js",
    "db:migrate": "node backend/src/db/run-sql.js backend/src/db/schema.sql",
    "db:seed": "node backend/src/db/run-sql.js backend/src/db/seeds.sql"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.0.1",
    "@mui/material": "^9.0.1",
    "@vitejs/plugin-react": "^4.7.0",
    "axios": "^1.17.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.17.0",
    "morgan": "^1.11.0",
    "multer": "^2.1.1",
    "mysql2": "^3.22.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^6.30.4",
    "vite": "^5.4.21",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.14"
  }
}
